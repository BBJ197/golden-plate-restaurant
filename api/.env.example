DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/golden_plate_restaurant

# Optional: email every contact-form message to the owner (free at resend.com).
# Leave these empty to only save messages in the admin "Messages" page.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# Optional: 16+ random characters, the same value as PROXY_SECRET on Cloudflare Pages.
# Lets the rate limits see each visitor's real IP. Leave empty in local development.
PROXY_SECRET=
CONTACT_FROM_EMAIL=Golden Plate <onboarding@resend.dev>